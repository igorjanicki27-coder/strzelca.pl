{
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://strzelca-pl.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://strzelca-pl.firebaseapp.com/__/firebase/:path*"
    },
    { "source": "/oferta/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
