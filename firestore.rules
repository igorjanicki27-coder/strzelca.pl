rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================================================
    // HELPER FUNCTIONS
    // =============================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin';
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.uid == 'nCMUz2fc8MM9WhhMVBLZ1pdR7O43';
    }

    function isAdminOrSuperAdmin() {
      return isAdmin() || isSuperAdmin();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function validRole(role) {
      return role is string && (role == 'user' || role == 'company' || role == 'admin');
    }

    // =============================================================================
    // USER PROFILES
    // =============================================================================
    match /userProfiles/{userId} {
      // Prywatne dane profilu - tylko właściciel lub admin/superadmin
      // Uwaga: Dla zapytań listowych (getDocs) admin musi mieć dostęp do wszystkich dokumentów
      allow read: if isOwner(userId) || isAdminOrSuperAdmin();

      // Tworzenie profilu - tylko dla właściciela podczas rejestracji
      allow create: if isOwner(userId) || isAdminOrSuperAdmin();

      // Aktualizacja - tylko właściciel (nie może zmienić własnej roli)
      allow update: if (isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role))
        || isAdminOrSuperAdmin();

      // Usuwanie profilu - tylko admin/superadmin (usuwanie konta robimy przez backend)
      allow delete: if isAdminOrSuperAdmin();
    }

    // =============================================================================
    // PUBLIC PROFILES (publiczne: nick + avatar)
    // =============================================================================
    match /publicProfiles/{userId} {
      // Publiczne dane: każdy może odczytać (np. podgląd profilu)
      allow read: if true;

      // Tworzy/aktualizuje tylko właściciel lub admin (kontrola pól)
      allow create, update: if (isOwner(userId) || isAdminOrSuperAdmin()) &&
        request.resource.data.keys().hasOnly(['displayName', 'avatar', 'updatedAt', 'role']) &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() >= 2 &&
        request.resource.data.displayName.size() <= 32 &&
        (!('avatar' in request.resource.data) || request.resource.data.avatar is string) &&
        (
          // Właściciel nie może zmieniać roli (może najwyżej zachować istniejącą)
          (isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role))
          ||
          // Admin może ustawić rolę
          (isAdminOrSuperAdmin() && (!('role' in request.resource.data) || validRole(request.resource.data.role)))
        );

      // Usuwanie: owner lub admin (np. sprzątanie konta)
      allow delete: if isOwner(userId) || isAdminOrSuperAdmin();
    }

    // =============================================================================
    // DISPLAY NAMES (sprawdzanie unikalności przy rejestracji)
    // =============================================================================
    match /displayNames/{displayName} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow delete: if isAdminOrSuperAdmin();
      allow update: if false;
    }

    // Wersje list publicznych (1 dokument = 1 odczyt zamiast getDocs całej kolekcji przy cache w przeglądarce)
    match /publicListCacheMeta/{key} {
      allow read: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // Lekki indeks wyszukiwania globalnego.
    // Uwaga: rekordy typu "user" są widoczne tylko dla zalogowanych.
    match /searchIndex/{docId} {
      allow read: if (resource.data.type != 'user') || isAuthenticated();
      allow create, update, delete: if false; // zapis wyłącznie przez backend (Admin SDK)
    }

    // =============================================================================
    // MESSAGES & CONVERSATIONS
    // =============================================================================
    match /messages/{messageId} {
      // Dla administratorów: pełny dostęp do wszystkich wiadomości
      allow read: if isAdminOrSuperAdmin();
      
      // Dla zwykłych użytkowników: tylko własne wiadomości lub te gdzie są odbiorcą 'admin'
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid ||
        resource.data.recipientId == 'admin'
      );

      allow create: if isAuthenticated() &&
        request.resource.data.senderId == request.auth.uid;

      // Użytkownik nie może zmieniać statusu/recipientId — to robi admin/backoffice
      allow update: if isAuthenticated() &&
        resource.data.senderId == request.auth.uid &&
        request.resource.data.senderId == resource.data.senderId &&
        request.resource.data.recipientId == resource.data.recipientId &&
        request.resource.data.status == resource.data.status;

      allow update, delete: if isAdminOrSuperAdmin();
    }

    match /conversations/{conversationId} {
      allow read: if isAdminOrSuperAdmin() || (isAuthenticated() && (
        conversationId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      ));

      // Tworzenie (best-effort) — zwykle przez system, ale zostawiamy dla zalogowanych
      allow create: if isAuthenticated();

      // Aktualizacja: użytkownik może aktualizować swoją konwersację, admin może wszystkie
      allow update: if isAdminOrSuperAdmin() || (isAuthenticated() && (
        conversationId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      ));

      allow delete: if isAdminOrSuperAdmin();
    }

    match /privateMessages/{messageId} {
      allow read: if isAdminOrSuperAdmin() || (isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      ));

      // Create: tylko uczestnicy i spójny conversationId (żeby nikt nie mógł "zatruć" cudzej konwersacji)
      allow create: if isAuthenticated() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.recipientId is string &&
        request.resource.data.recipientId.size() >= 10 &&
        request.resource.data.recipientId != request.auth.uid &&
        request.resource.data.content is string &&
        request.resource.data.content.size() >= 1 &&
        request.resource.data.content.size() <= 4000 &&
        request.resource.data.isRead == false &&
        // Pozwalamy na serverTimestamp(): w regułach jest to równe request.time
        request.resource.data.timestamp == request.time &&
        request.resource.data.conversationId is string &&
        (
          request.resource.data.conversationId ==
            (request.resource.data.senderId + "_" + request.resource.data.recipientId) ||
          request.resource.data.conversationId ==
            (request.resource.data.recipientId + "_" + request.resource.data.senderId)
        );

      // Update: pozwalamy tylko na oznaczenie wiadomości jako przeczytanej (`isRead=true`)
      // przez nadawcę lub odbiorcę, bez możliwości edycji treści / uczestników.
      allow update: if isAuthenticated() &&
        (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid) &&
        request.resource.data.senderId == resource.data.senderId &&
        request.resource.data.recipientId == resource.data.recipientId &&
        request.resource.data.content == resource.data.content &&
        request.resource.data.conversationId == resource.data.conversationId &&
        request.resource.data.timestamp == resource.data.timestamp &&
        request.resource.data.isRead == true;

      allow delete: if isAdminOrSuperAdmin();
    }

    match /privateConversations/{conversationId} {
      allow read: if isAdminOrSuperAdmin() || (isAuthenticated() && (
        request.auth.uid in resource.data.participants &&
        (!('deletedBy' in resource.data) || !(request.auth.uid in resource.data.deletedBy) || resource.data.deletedBy[request.auth.uid] != true)
      ));

      // Tworzenie/aktualizacja: tylko uczestnicy (minimalnie)
      allow create: if isAuthenticated() &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() == 2 &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants[0] is string &&
        request.resource.data.participants[1] is string &&
        request.resource.data.participants[0] != request.resource.data.participants[1] &&
        request.resource.data.unreadCounts is map &&
        request.resource.data.unreadCounts[request.auth.uid] == 0 &&
        (
          conversationId ==
            (request.resource.data.participants[0] + "_" + request.resource.data.participants[1]) ||
          conversationId ==
            (request.resource.data.participants[1] + "_" + request.resource.data.participants[0])
        );

      // Aktualizacja: tylko uczestnicy i bez zmiany participants
      // Pozwalamy na aktualizację deletedBy dla soft delete
      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants &&
        (
          // Zwykła aktualizacja (bez deletedBy)
          (!('deletedBy' in request.resource.data) && !('deletedBy' in resource.data)) ||
          // Soft delete - tylko użytkownik może oznaczyć siebie jako usuwającego
          ('deletedBy' in request.resource.data && 
           request.resource.data.deletedBy is map &&
           request.resource.data.deletedBy[request.auth.uid] == true &&
           (!('deletedBy' in resource.data) || resource.data.deletedBy[request.auth.uid] != true))
        );

      allow delete: if isAdminOrSuperAdmin();
    }

    // Lekki inbox użytkownika (badge unread) aktualizowany przez backend (Admin SDK).
    match /userInboxes/{userId} {
      allow read: if isOwner(userId) || isAdminOrSuperAdmin();
      allow create, update, delete: if false;
    }

    // =============================================================================
    // MAILING LIST & CONTACT FORMS
    // =============================================================================
    match /mailingList/{email} {
      // DocID = email. Pozwalamy zapisać się (także gościom), ale tylko dla zgodnego docId/email.
      allow create: if request.resource.data.email == email;

      // Zalogowany użytkownik może zarządzać swoim mailem
      allow update, delete: if isAuthenticated() &&
        request.auth.token.email != null &&
        request.auth.token.email == email;

      // Pełny wgląd dla admina
      allow read, create, update, delete: if isAdminOrSuperAdmin();
    }

    match /contactForms/{formId} {
      allow create: if true;
      allow read, update, delete: if isAdminOrSuperAdmin();
    }

    match /newsletterQueue/{queueId} {
      // Admin może odczytywać i zarządzać kolejką newslettera
      allow read, create, update, delete: if isAdminOrSuperAdmin();
      
      // System może tworzyć wpisy w kolejce (np. podczas wysyłki)
      allow create: if isAuthenticated();
    }

    // =============================================================================
    // BAZAR OFFERS (ogłoszenia C2C)
    // =============================================================================
    match /bazarOffers/{offerId} {
      allow read: if true;

      allow create: if isAuthenticated() &&
        request.resource.data.seller_id == request.auth.uid &&
        request.resource.data.status == 'PENDING';

      allow update: if isAuthenticated() && (
        isAdminOrSuperAdmin() ||
        (resource.data.seller_id == request.auth.uid &&
         request.resource.data.seller_id == resource.data.seller_id &&
         request.resource.data.status == resource.data.status &&
         request.resource.data.is_pinned == resource.data.is_pinned &&
         request.resource.data.approved_at == resource.data.approved_at &&
         request.resource.data.expires_at == resource.data.expires_at &&
         request.resource.data.last_refreshed_at == resource.data.last_refreshed_at)
      );

      allow delete: if isAuthenticated() && (
        isAdminOrSuperAdmin() ||
        resource.data.seller_id == request.auth.uid
      );
    }

    // =============================================================================
    // CONTENT: PRODUCTS, TRAININGS, EVENTS, CHARITY
    // =============================================================================
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    match /trainings/{trainingId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // Zgłoszenia na stronę event.html (dokumentacja strzelnicy) — zapis publiczny, odczyt/edycja tylko admin
    match /mojEventParticipants/{participantId} {
      allow create: if
        request.resource.data.keys().hasOnly(['imie', 'nazwisko', 'ulica', 'numerBudynku', 'numerLokalu', 'miejscowosc', 'zatwierdzono', 'createdAt']) &&
        request.resource.data.imie is string &&
        request.resource.data.imie.size() >= 1 && request.resource.data.imie.size() <= 100 &&
        request.resource.data.nazwisko is string &&
        request.resource.data.nazwisko.size() >= 1 && request.resource.data.nazwisko.size() <= 100 &&
        request.resource.data.ulica is string &&
        request.resource.data.ulica.size() >= 1 && request.resource.data.ulica.size() <= 150 &&
        request.resource.data.numerBudynku is string &&
        request.resource.data.numerBudynku.size() >= 1 && request.resource.data.numerBudynku.size() <= 30 &&
        request.resource.data.numerLokalu is string &&
        request.resource.data.numerLokalu.size() <= 30 &&
        request.resource.data.miejscowosc is string &&
        request.resource.data.miejscowosc.size() >= 1 && request.resource.data.miejscowosc.size() <= 100 &&
        request.resource.data.zatwierdzono == false &&
        request.resource.data.createdAt is timestamp;

      allow read, update, delete: if isAdminOrSuperAdmin();
    }

    // Wpis bloga — odczyt publiczny (strona + zapytania listowe w panelu). Wymaga wdrożenia: firebase deploy --only firestore:rules
    match /blogPosts/{postId} {
      allow get, list: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    match /charity/{charityId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    match /documents/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    match /trainingAccess/{accessId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdminOrSuperAdmin()
      );
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    match /courseLessons/{lessonId} {
      // Odczyt: zalogowani użytkownicy (dostęp sprawdzany w kodzie aplikacji)
      allow read: if isAuthenticated();
      
      // Zapis: tylko admin
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // Liczniki numerów certyfikatów szkoleniowych (tylko +1 na kurs; zapis w transakcji z publicTrainingCertificates)
    match /trainingCertificateCounters/{trainingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['lastSerial']) &&
        request.resource.data.lastSerial is int &&
        request.resource.data.lastSerial == 1;
      allow update: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['lastSerial']) &&
        resource.data.lastSerial is int &&
        request.resource.data.lastSerial == resource.data.lastSerial + 1;
      allow delete: if false;
    }

    // Publiczny rejestr certyfikatów (weryfikacja + lista na certyfikaty.html)
    match /publicTrainingCertificates/{certId} {
      allow get, list: if true;

      allow create: if isAuthenticated() &&
        certId == request.resource.data.trainingId + '_' + request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'certificateNumber',
          'courseSlug',
          'courseTitle',
          'serialNumber',
          'trainingId',
          'recipientName',
          'userId',
          'issuedAt',
        ]) &&
        request.resource.data.trainingId is string &&
        request.resource.data.trainingId.size() >= 4 &&
        request.resource.data.trainingId.size() <= 128 &&
        request.resource.data.serialNumber is int &&
        request.resource.data.serialNumber >= 1 &&
        request.resource.data.serialNumber < 10000000 &&
        request.resource.data.recipientName is string &&
        request.resource.data.recipientName.size() >= 1 &&
        request.resource.data.recipientName.size() <= 200 &&
        request.resource.data.courseTitle is string &&
        request.resource.data.courseTitle.size() >= 1 &&
        request.resource.data.courseTitle.size() <= 300 &&
        request.resource.data.courseSlug is string &&
        request.resource.data.courseSlug.size() >= 1 &&
        request.resource.data.courseSlug.size() <= 120 &&
        request.resource.data.certificateNumber is string &&
        request.resource.data.certificateNumber.size() >= 16 &&
        request.resource.data.certificateNumber.size() <= 500 &&
        request.resource.data.certificateNumber.matches('^STRZELCA\\.PL/[A-Z0-9_]+/[1-9][0-9]{0,6}$') &&
        request.resource.data.issuedAt == request.time;

      allow update, delete: if false;
    }

    match /courseProgress/{progressId} {
      // Odczyt: tylko właściciel postępu lub admin
      allow read: if isAuthenticated() && (
        isAdminOrSuperAdmin() ||
        (progressId.matches('.*_.*') && 
         progressId.split('_')[0] == request.auth.uid)
      );
      
      // Zapis: tylko właściciel postępu lub admin
      allow create, update: if isAuthenticated() && (
        isAdminOrSuperAdmin() ||
        (progressId.matches('.*_.*') && 
         progressId.split('_')[0] == request.auth.uid &&
         request.resource.data.userId == request.auth.uid)
      );
      
      // Usuwanie: tylko admin
      allow delete: if isAdminOrSuperAdmin();
    }

    // =============================================================================
    // USER REVIEWS
    // =============================================================================
    match /userReviews/{reviewId} {
      allow read: if true;

      // Model danych używany w profilu:
      // { raterId, ratedId, rating, comment, timestamp, ... }
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasAll(['raterId', 'ratedId', 'rating', 'comment']) &&
        request.resource.data.raterId == request.auth.uid &&
        request.resource.data.ratedId != request.auth.uid &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5;

      // Edycja/usuwanie opinii tylko przez admina (żeby nie było nadużyć)
      allow update, delete: if isAdminOrSuperAdmin();
    }

    // =============================================================================
    // LOGS & SYSTEM
    // =============================================================================
    match /activityLogs/{logId} {
      allow read: if isAdminOrSuperAdmin() || (isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.adminId == request.auth.uid
      ));

      // Zabezpieczamy przed wpisami "w cudzym imieniu"
      // Pozwalamy na logi systemowe (userId == "system") dla adminów
      allow create: if isAuthenticated() &&
        (
          // Użytkownik może logować swoje własne akcje
          (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid) ||
          // Lub logi systemowe - dla adminów (bez wymagania pola automatic)
          (request.resource.data.userId == 'system' && 
           'action' in request.resource.data &&
           isAdminOrSuperAdmin() &&
           ('details' in request.resource.data) &&
           (request.resource.data.details is map || request.resource.data.details is string))
        );

      allow update, delete: if isAdminOrSuperAdmin();
    }

    // Obecność gości (heartbeat z API ping-activity) — tylko odczyt dla admina; zapis wyłącznie przez backend
    match /guestPresence/{docId} {
      allow read: if isAdminOrSuperAdmin();
      allow create, update, delete: if false;
    }

    match /user_events/{eventId} {
      allow read: if isAdminOrSuperAdmin() || (isAuthenticated() &&
        resource.data.userId == request.auth.uid);

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAdminOrSuperAdmin();
    }

    match /system_events/{eventId} {
      allow read, create, update, delete: if isAdminOrSuperAdmin();
    }

    match /messageCategories/{categoryId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    match /quickReplies/{replyId} {
      allow read, create, update, delete: if isAdminOrSuperAdmin();
    }

    match /quick_replies/{replyId} {
      allow read, create, update, delete: if isAdminOrSuperAdmin();
    }

    match /pendingTasks/{taskId} {
      allow read, create, update, delete: if isAdminOrSuperAdmin();
    }

    // =============================================================================
    // ORDERS & EMAIL TEMPLATES
    // =============================================================================
    match /orders/{orderId} {
      // Admin może wszystko
      allow read, create, update, delete: if isAdminOrSuperAdmin();
      
      // Użytkownik może odczytywać tylko swoje zamówienia
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.email != null && 
         request.auth.token.email != null && 
         resource.data.email == request.auth.token.email);
    }

    match /emailTemplates/{templateId} {
      // Tylko admin może zarządzać szablonami maili
      allow read, create, update, delete: if isAdminOrSuperAdmin();
    }

    // =============================================================================
    // INVOICES (Faktury)
    // =============================================================================
    match /invoices/{invoiceId} {
      // Użytkownik może odczytać fakturę tylko dla swoich zamówień
      // Admin może odczytać wszystkie faktury
      allow read: if isAuthenticated() && (
        isAdminOrSuperAdmin() ||
        (exists(/databases/$(database)/documents/orders/$(invoiceId)) &&
         get(/databases/$(database)/documents/orders/$(invoiceId)).data.userId == request.auth.uid)
      );
      
      // Tylko admin może tworzyć i aktualizować faktury
      allow create, update, delete: if isAdminOrSuperAdmin();
    }

    // =============================================================================
    // VISITS & ANALYTICS
    // =============================================================================
    match /visits/{visitId} {
      // Admin może odczytywać wszystkie wizyty (dla statystyk)
      allow read: if isAdminOrSuperAdmin();
      
      // Tworzenie wizyt - każdy może tworzyć (tracking odwiedzin)
      allow create: if true;
      
      // Aktualizacja i usuwanie - tylko admin
      allow update, delete: if isAdminOrSuperAdmin();
    }

    // =============================================================================
    // TEST COLLECTION (dla testów połączenia)
    // =============================================================================
    match /_test/{testId} {
      // Admin może odczytywać i tworzyć dokumenty testowe
      allow read, create: if isAdminOrSuperAdmin();
      allow update, delete: if isAdminOrSuperAdmin();
    }

    // =============================================================================
    // SERVER SECRETS (tylko Admin SDK — klient Firebase nie ma dostępu)
    // Np. sekret crona bazar-cron-expire: serverSecrets/bazarCronExpire.cronSecret
    // =============================================================================
    match /serverSecrets/{docId} {
      allow read, write: if false;
    }

    // =============================================================================
    // DEFAULT DENY
    // =============================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
