{
  "version": 2,
  "functions": {
    "api/messages.js": {
      "maxDuration": 60
    },
    "api/orders.js": {
      "maxDuration": 60
    },
    "api/newsletter-cron-process.js": {
      "maxDuration": 60
    },
    "api/search-index-cron-dry-run.js": {
      "maxDuration": 60
    },
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/bazar-cron-expire",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/newsletter-cron-process",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/search-index-cron-dry-run",
      "schedule": "0 6 * * 1"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "strefa.strzelca.pl"
        }
      ],
      "destination": "https://strzelca.pl/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.strzelca.pl"
        }
      ],
      "destination": "https://strzelca.pl/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/ikona.svg" },
    { "source": "/sklep", "destination": "/index.html" },
    { "source": "/sklep/", "destination": "/index.html" },
    { "source": "/bazar", "destination": "/index.html" },
    { "source": "/bazar/", "destination": "/index.html" },
    { "source": "/szkolenia", "destination": "/index.html" },
    { "source": "/szkolenia/", "destination": "/index.html" },
    { "source": "/wydarzenia", "destination": "/index.html" },
    { "source": "/wydarzenia/", "destination": "/index.html" },
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/blog/", "destination": "/index.html" },
    { "source": "/pomoc", "destination": "/index.html" },
    { "source": "/pomoc/", "destination": "/index.html" },
    { "source": "/dokumenty", "destination": "/index.html" },
    { "source": "/dokumenty/", "destination": "/index.html" },
    { "source": "/kontakt", "destination": "/index.html" },
    { "source": "/kontakt/", "destination": "/index.html" },
    { "source": "/profil/(.*)", "destination": "/profil.html?profile=$1" },
    { "source": "/api/messages/(.*)", "destination": "/api/messages?__path=$1" },
    { "source": "/api/private-messages/(.*)", "destination": "/api/private-messages?__path=$1" },
    { "source": "/api/bazar/cron/expire", "destination": "/api/bazar-cron-expire" },
    { "source": "/api/newsletter/cron/process", "destination": "/api/newsletter-cron-process" },
    { "source": "/api/search-index/cron/dry-run", "destination": "/api/search-index-cron-dry-run" },
    { "source": "/api/bazar/(.*)", "destination": "/api/bazar?__path=$1" },
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/ikona.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*\\.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*\\.webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*\\.jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*\\.jpeg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*\\.ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
