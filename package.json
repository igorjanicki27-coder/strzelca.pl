{
  "name": "strzelca.pl",
  "version": "1.0.0",
  "description": "System zarządzania stroną strzelca.pl",
  "scripts": {
    "build:admin-css": "tailwindcss -c tailwind.admin.config.js -i ./admin/tw-input.css -o ./admin/admin.tailwind.min.css --minify",
    "build:blog-css": "tailwindcss -c tailwind.blog.config.js -i ./blog.strzelca.pl/tw-input.css -o ./blog.strzelca.pl/blog.tailwind.min.css --minify",
    "build:css": "npm run build:admin-css && npm run build:blog-css"
  },
  "dependencies": {
    "@google-analytics/data": "^4.0.1",
    "firebase-admin": "^12.0.0",
    "nodemailer": "^6.9.8"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.17"
  }
}
